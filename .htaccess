<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /Join/

  # Wenn Datei oder Verzeichnis existiert → nicht umschreiben
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Ausnahmen für statische Dateien (Fonts, Bilder, Scripts usw.)
  RewriteRule \.(woff|woff2|ttf|otf|eot|txt|png|jpg|jpeg|gif|svg|ico|css|js)$ - [L,NC]

  # Alles andere an login.html weiterleiten
  RewriteRule ^.*$ login.html [L]
</IfModule>

# Fehlerseite bei 404 innerhalb von /Join/
ErrorDocument 404 /Join/login.html

# Caching für statische Dateien
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-ttf "access plus 1 year"
</IfModule>

# MIME-Typen für Schriftarten
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType application/x-font-ttf .ttf
</IfModule>
